# Copy to backend/.env or project root .env

# Application
DEBUG=true
ENVIRONMENT=development

# Database (SQLite default; use Postgres for production)
DATABASE_URL=sqlite:///./data/decision_intelligence.db

# Paths (relative to backend working directory)
DATA_PATH=./data
MODEL_PATH=./data/models

# Auth — always set a strong secret outside local dev
JWT_SECRET=change-me-in-production

# CORS (comma-separated if your settings parser supports it; default is hard-coded for local)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ML / confidence (Phase 1a)
CONFIDENCE_THRESHOLD=0.7
CONFORMAL_ALPHA=0.1
DISAGREEMENT_THRESHOLD=0.25
INTERVAL_WIDTH_THRESHOLD=0.4
